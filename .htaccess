
# Désactiver le listing des répertoires
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirection .com vers .fr
    RewriteCond %{HTTP_HOST} ^(www\.)?lesclesducapcir\.com$ [NC]
    RewriteRule ^(.*)$ https://lesclesducapcir.fr/$1 [L,R=301]

    # Bloquer model/ entièrement
    RewriteRule ^model/ - [F,L]
    # Bloquer data/ sauf data/uploads/ (images publiques)
    RewriteRule ^data/(?!uploads/) - [F,L]
</IfModule>

# Bloquer les fichiers sensibles
<FilesMatch "\.(ini|json|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
